# Copy to .env (git-ignored) and fill in. Load with:  set -a; source .env; set +a
NEBIUS_API_KEY=
# Optional
TAVILY_API_KEY=
# DAWA_PROVIDER=nebius          # nebius | ollama | offline
# DAWA_TEXT_MODEL=nvidia/Nemotron-3_5-Lightning
# DAWA_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# For a hosted demo: visitors start locked (samples and price checks only, no model or web calls) until they enter this code. Leave unset for local use.
# DAWA_ACCESS_CODE=
# Shared daily budget for a hosted demo (all visitors together, resets 00:00 UTC): when used up the app falls back to rules only (samples and price checks keep working).
# DAWA_DAILY_PHOTO_READS=100
# DAWA_DAILY_MODEL_CALLS=600
# DAWA_DAILY_WEB_CALLS=400
# DAWA_MAX_PHOTO_READS=15
